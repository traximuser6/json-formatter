{
  "name": "json-cleaner-formatter",
  "version": "1.1.0",
  "description": "Transform messy, malformed, or double-encoded JSON into clean, structured beauty — CLI + Web App",
  "keywords": [
    "json",
    "json-cleaner",
    "json-formatter",
    "json-parser",
    "json-repair",
    "malformed-json",
    "double-encoded-json",
    "cli",
    "developer-tools"
  ],
  "author": "Traxim",
  "license": "MIT",
  "homepage": "https://ttech-json-formatter.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traximuser6/json-cleaner.git"
  },
  "bugs": {
    "url": "https://github.com/traximuser6/json-cleaner/issues"
  },
  "type": "commonjs",
  "main": "src/cli.js",
  "bin": {
    "json-cleaner": "src/cli.js"
  },
  "files": [
    "src/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "start": "node src/cli.js",
    "clean": "node src/cli.js",
    "clean:sample": "node src/cli.js --input=samples/messy.txt --output=samples/clean.json",
    "clean:minify": "node src/cli.js --minify",
    "web:serve": "npx serve public",
    "web:dev": "npx live-server public --port=4500 --open=index.html",
    "test": "node --test test/",
    "test:watch": "node --test --watch test/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md,html,css}\"",
    "verify": "npm run lint && npm run format:check && npm run test",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0"
  }
}